# ─── Web (Next.js) — Environment Variables ─────────────────────────────────
# Copy this file to .env.local for local development.
# On Vercel: add these in Project → Settings → Environment Variables.
# NEVER commit .env.local — only this .env.example file is safe to commit.

# ── Required ──────────────────────────────────────────────────────────────

# The public URL of your deployed Vercel site.
# Used for Open Graph meta tags and canonical URLs.
# Example: https://srabon-portfolio.vercel.app
NEXT_PUBLIC_SITE_URL=

# The base URL of your Express API (deployed on Render or Railway).
# Must NOT have a trailing slash.
# Example: https://srabon-api.onrender.com/api
# Leave blank to use seed data only (works without a backend).
NEXT_PUBLIC_API_URL=

# ── Optional ──────────────────────────────────────────────────────────────

# Shared secret for on-demand ISR revalidation.
# Must match REVALIDATE_SECRET in server/.env.
# Example: some-random-string-32-chars
REVALIDATE_SECRET=
