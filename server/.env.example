# Server environment variables
# Copy this file to .env and fill in real values.
# NEVER commit .env — only this .env.example file.

MONGODB_URI=
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=            # used only by the seed script, not at runtime
CLIENT_ORIGIN=             # e.g. https://your-portfolio.vercel.app
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GITHUB_TOKEN=              # optional — avoids GitHub API rate limits
SMTP_USER=                 # Gmail address for Nodemailer
SMTP_PASS=                 # Gmail app password (not your normal password)
CONTACT_TO_EMAIL=          # where contact form emails are sent
REVALIDATE_SECRET=         # shared with web/ to trigger ISR revalidation
